{
  "manifest_version": 3,
  "name": "Once Translator - Traditional Chinese Subtitles",
  "version": "0.1.0",
  "description": "Overlay LLM-translated Traditional Chinese subtitles on K-pop YouTube videos.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Once Translator settings"
  }
}
