# Which LLM to use for translation: "gemini" (free tier, good for POC), "anthropic" (paid,
# higher quality), "deepseek" (paid, very cheap, no punishing daily quota like Gemini free
# tier), or "local" (your own OpenAI-compatible server - Ollama, LM Studio, etc - free and
# private, but only as good as whatever model you have loaded)
TRANSLATION_PROVIDER=gemini

# Required if TRANSLATION_PROVIDER=gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Free-tier requests/minute cap - client-side throttled to this to avoid 429s. Check your
# actual limit at https://aistudio.google.com/app/apikey if you're unsure (Google no longer
# publishes a fixed table; 5/min is what we measured for gemini-3.6-flash free tier).
GEMINI_RPM=5
GEMINI_MAX_RETRIES=5
# Gemini free tier also caps total *requests per day* (as low as 20/day for some models) -
# pacing can't work around that, only fewer/larger requests can. This controls how many
# subtitle lines go into one translation call; raise it to use fewer requests per video.
TRANSLATE_BATCH_SIZE=200

# Required if TRANSLATION_PROVIDER=anthropic: your own key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required if TRANSLATION_PROVIDER=deepseek: your own key from https://platform.deepseek.com/api_keys
# Note: a mainland Chinese model - output may lean toward Simplified-Chinese vocabulary/idiom
# even when asked for zh-TW; check a sample of real subtitles before relying on it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_RETRIES=5

# Required if TRANSLATION_PROVIDER=local: base URL of your OpenAI-compatible local server
# (Ollama's default shown below; LM Studio's default is http://localhost:1234/v1). The model
# itself isn't set here - the dashboard fetches whichever models that server has loaded and
# lets you pick one from a dropdown per request. LOCAL_LLM_MODEL is just the fallback used
# when a request doesn't specify one (e.g. calling /process directly without llm_model).
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=

# Optional overrides
WHISPER_MODEL_SIZE=small
DATA_DIR=./data

# If YouTube blocks yt-dlp with "Sign in to confirm you're not a bot": export your logged-in
# YouTube cookies to a file (see README "Troubleshooting") and point this at it. Preferred
# over YTDLP_COOKIES_FROM_BROWSER below since it works while your browser stays open.
YTDLP_COOKIES_FILE=
# Alternative: a browser name (chrome, edge, firefox, brave, ...) - only reliable while that
# browser is fully closed (it reads the browser's live cookie DB, which locks while running).
YTDLP_COOKIES_FROM_BROWSER=
